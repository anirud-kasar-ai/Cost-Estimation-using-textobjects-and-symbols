# Copy this file to `.env` (same directory) and adjust as needed.
# All variables are optional — sensible local defaults are baked into backend/config.py.

# --- Core ---
# Use deterministic mock model outputs instead of real Detectron2/PaddleOCR/ONNX models.
# Keep `true` until trained weights exist in backend/models/.
HVAC_USE_MOCK_MODELS=true

# SQLite database location (relative paths resolve against the backend/ directory).
HVAC_DATABASE_URL=sqlite:///./storage/hvac.db

# Where uploaded PDFs and intermediate page images are stored.
HVAC_STORAGE_DIR=./storage

# --- PDF conversion (speed knobs) ---
# Lower DPI / fewer pages = much faster uploads on large bid sets.
# Defaults in config.py are 120 DPI / 8 pages (POC-friendly).
HVAC_PDF_DPI=120
# Path to the poppler `bin` directory (only needed on Windows when poppler is not on PATH).
# If unset and poppler is unavailable, the app falls back to PyMuPDF automatically.
# HVAC_POPPLER_PATH=C:\tools\poppler\Library\bin

# --- Upload validation ---
# Uploads are unlimited in size by default. Uncomment to enforce a cap (MB).
# HVAC_MAX_UPLOAD_MB=500
# Max pages to RENDER for device detection (requirement text still scans the PDF).
HVAC_MAX_PDF_PAGES=8

# --- Model weight paths (used only when HVAC_USE_MOCK_MODELS=false) ---
HVAC_ROI_MODEL_PATH=./models/roi_detector.pth
HVAC_ROI_MODEL_CONFIG=./models/roi_detector.yaml
HVAC_SYMBOL_MODEL_PATH=./models/symbol_detector.pth
HVAC_SYMBOL_MODEL_CONFIG=./models/symbol_detector.yaml
HVAC_CLASSIFIER_MODEL_PATH=./models/device_classifier.onnx

# --- Cost data ---
HVAC_COST_RATES_PATH=./data/cost_rates.json
