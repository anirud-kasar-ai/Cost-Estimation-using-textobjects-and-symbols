# Copy to .env and fill in keys. Never commit .env.

# Vision LLM runtime: groq | hf
VISION_LLM_RUNTIME=groq
VISION_REQUIRE_LLM=true

# Groq (default)
GROQ_API_KEY=
GROQ_MODEL_ID=qwen/qwen3.6-27b

# Optional Hugging Face local / endpoint runtime
HF_TOKEN=
HF_MODEL_ID=meta-llama/Llama-3.2-11B-Vision-Instruct
HF_INFERENCE_ENDPOINT=
HF_LOAD_4BIT=true
VISION_DEVICE=auto
VISION_ALLOW_CPU_MODEL=false

# Rendering / zoom tiles (653px + 10% overlap feeds symbol-count-vision)
VISION_PDF_DPI=200
VISION_LLAMA_MAX_SIDE=1280
ROI_ZOOM_TILE_SIZE=653
ROI_ZOOM_OVERLAP_PCT=0.10

# Optional embedded symbol-count step inside this pipeline
SYMBOL_COUNT_ENABLED=true
SYMBOL_COUNT_NMS_IOU=0.5
EXTRACTION_CACHE_ENABLED=true
SHEET_NOTES_GLYPH_CROP=false
