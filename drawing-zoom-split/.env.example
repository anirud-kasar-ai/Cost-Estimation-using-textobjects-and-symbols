# Copy to .env and fill in keys. Never commit .env.

# Vision LLM runtime: groq | hf
VISION_LLM_RUNTIME=groq
VISION_REQUIRE_LLM=true

# Groq (default)
GROQ_API_KEY=
GROQ_MODEL_ID=qwen/qwen3.6-27b

# Optional Hugging Face local / endpoint runtime
HF_TOKEN=
HF_MODEL_ID=meta-llama/Llama-3.2-11B-Vision-Instruct
HF_INFERENCE_ENDPOINT=
HF_LOAD_4BIT=true
VISION_DEVICE=auto
VISION_ALLOW_CPU_MODEL=false

# Rendering / zoom tiles (588px + 10% overlap; 10% closer than the old 653px tiles)
VISION_PDF_DPI=200
VISION_LLAMA_MAX_SIDE=1280
ROI_ZOOM_TILE_SIZE=588
ROI_ZOOM_OVERLAP_PCT=0.10

EXTRACTION_CACHE_ENABLED=true
SHEET_NOTES_GLYPH_CROP=false

# YOLO symbol count on ROI zoom tiles (weights default: model/symbol_detector_best.pt)
YOLO_ENABLED=true
SYMBOL_COUNT_ENABLED=true
YOLO_MODEL_PATH=
YOLO_CONF=0.35
YOLO_IOU=0.45
YOLO_IMGSZ=1280
YOLO_MATCH_MIN_SCORE=0.55
YOLO_NMS_IOU=0.35
YOLO_CROSS_NMS_IOU=0.50
YOLO_NMS_CENTER_PX=16

# Pricing / cost invoice (CSV lives in pricing/device_prices.csv)
PRICING_CSV_PATH=
INVOICE_TAX_RATE=0.0
