# Optional — only needed if tesseract is not on PATH
TESSERACT_CMD=

# Tuning (optional)
LEGEND_OCR_MIN_CONF=40
# Set true to enable circled callout OCR counting
CALLOUT_OCR_ENABLED=false
CALLOUT_OCR_MIN_CONF=30
CALLOUT_MIN_RADIUS_PX=5
CALLOUT_MAX_RADIUS_PX=28
CALLOUT_NMS_IOU=0.30
CALLOUT_DEDUP_DIST_PX=22
LEGEND_PDF_DPI=200

# YOLO symbol detector (defaults to model/symbol_detector_best.pt)
YOLO_ENABLED=true
YOLO_MODEL_PATH=
YOLO_CONF=0.35
YOLO_IOU=0.45
YOLO_IMGSZ=1280
YOLO_MATCH_MIN_SCORE=0.55
YOLO_PRIMARY_COUNTS=true
YOLO_KEEP_OBJECT_CLASS=false
YOLO_NMS_IOU=0.35
YOLO_CROSS_NMS_IOU=0.50
YOLO_NMS_CENTER_PX=16
TILE_OVERLAP_PCT=0.10
