# Environment / secrets — never commit
.env
.env.*
!.env.example
**/.env
**/.env.local
**/.env.*.local
*.pem
*credentials*.json
**/secrets/

# Standalone tool job outputs (large; may contain user uploads)
dual-pathway-drawing-split/storage/jobs/
dual-pathway-drawing-split/storage/extraction_cache/
dual-pathway-drawing-split/storage/requirements/
dual-pathway-drawing-split/storage/technical_symbols/
symbol-count-vision/storage/jobs/
symbol-count-vision/storage/_*/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
*.sqlite3

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# App runtime / uploads / generated artifacts
hvac-cost-estimator/backend/storage/*
!hvac-cost-estimator/backend/storage/.gitkeep
# Keep generated requirement PDFs in the repo
!hvac-cost-estimator/backend/storage/requirements/
!hvac-cost-estimator/backend/storage/requirements/**
# Keep generated technical symbol PDFs in the repo
!hvac-cost-estimator/backend/storage/technical_symbols/
!hvac-cost-estimator/backend/storage/technical_symbols/**
hvac-cost-estimator/backend/models/*
!hvac-cost-estimator/backend/models/.gitkeep
mlruns/

# Duplicate / scratch requirement copies
Real data/requirements - Copy/

