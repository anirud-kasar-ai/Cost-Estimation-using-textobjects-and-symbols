# Copy to .env and fill in keys. Never commit .env.

# CV / OCR
CV_OCR_MIN_CONF=60
CV_OCR_MIN_HEIGHT=8
CV_OCR_MAX_HEIGHT=40
CV_TEMPLATE_THRESHOLD=0.72
CV_TEMPLATE_SCALES=0.2,0.25,0.3,0.4,0.5,0.7,1.0
CV_TEMPLATE_MIN_SIZE=12
CV_TITLE_BAND_PCT=0.12
SYMBOL_COUNT_NMS_IOU=0.3

# Optional Windows path to tesseract.exe if not on PATH
TESSERACT_CMD=

# Used by tests/CI so FastAPI background jobs can run synchronously
SYMBOL_COUNT_SYNC_JOBS=false

# Symbol detection/verify is Gemini-only. Groq and Llama are not used.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

SYMBOL_COUNT_USE_LLM=true
SYMBOL_COUNT_USE_VISION_OCR=false
FOLDER_USE_VISION_OCR=false
FOLDER_VISION_COUNT_VERIFY=false
LLM_MAX_IMAGE_DIM=1280
LLM_TIMEOUT_S=30
MERGE_EVAL_MAX_JUDGE_CALLS=16
VISION_CLASSIFY_MAX_PER_TILE=4
TILE_DETECT_WORKERS=4
CV_OCR_ROTATIONS=0
GLYPH_IDENT_MIN=0.55
GLYPH_IDENT_MARGIN=0.08
