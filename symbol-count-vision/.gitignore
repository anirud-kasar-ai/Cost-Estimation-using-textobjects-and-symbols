storage/jobs/
storage/_debug*/
storage/_gemini*/
storage/_pdf*/
storage/_debug*/
storage/*.png
storage/*.jpg
storage/*.jpeg
storage/*.webp
!storage/jobs/.gitkeep

# OS / editors
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
