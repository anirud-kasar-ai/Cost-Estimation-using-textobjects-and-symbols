# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*credentials*
*secret*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

